// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

// ================================================================= //
//                            ENUMS                              
// ================================================================= //

enum RecipeCategory {
  BREAD // 面包类 (将强制执行烘焙百分比验证)
  PASTRY // 西点类
  DESSERT // 甜品类
  DRINK // 饮品类
  OTHER // 其他
}

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum SmsPurpose {
  REGISTER
}

// 店铺状态枚举
enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum JoinLinkStatus {
  ACTIVE
  REVOKED
}

enum ProductionTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum IngredientType {
  STANDARD // 标准原料，计入成本
  UNTRACKED // 非追踪原料，如水、盐等低价值或难计量的
  NON_INVENTORIED // 即时采购原料，计入成本但不做数量追踪，如生鲜类原料
  SELF_MADE // [新增] 自制原料，由 PRE_DOUGH 或 EXTRA 配方生产
}

// 新增：配方类型枚举
// 用于区分是主配方、预制面团还是馅料等附加项
enum RecipeType {
  MAIN // 主面团配方，包含最终产品
  PRE_DOUGH // 预制面团/面种配方，如烫种、波兰种
  EXTRA // 馅料/表面装饰等附加配方，如卡仕达酱
}

// 新增：产品中的原料类型枚举
// 用于区分产品中的原料是搅拌加入、作为馅料还是表面装饰
enum ProductIngredientType {
  MIX_IN // 搅拌时加入的原料 (如香草籽)
  FILLING // 包入的馅料 (如卡仕达酱)
  TOPPING // 表面装饰 (如芝士粉)
}

// 定义原料SKU的启用状态
enum SkuStatus {
  ACTIVE // 启用
  INACTIVE // 未启用
}

enum TaskItemRole {
  FINAL_PRODUCT // 最终产品（主任务的产物，如面包、蛋糕）
  PREP_INGREDIENT // 前置备料（前置准备任务制作的自制原料，如卡仕达酱、波兰种）
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum EntitlementTier {
  FREE
  PRO
}

enum EntitlementPolicyStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum PaymentOrderStatus {
  PENDING
  PAID
  CLOSED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentRefundStatus {
  PENDING
  SUCCESS
  CLOSED
  ABNORMAL
}

enum RecipeEditorSessionStatus {
  PENDING
  APPROVED
  EXPIRED
}

enum RecipeDraftStatus {
  DRAFT
  SYNCED
  ARCHIVED
}

enum RecipeImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ================================================================= //
//                         CORE AUTH & TENANCY                       //
// ================================================================= //

// 用户账户模型
model User {
  id                             String                  @id @default(uuid())
  phone                          String?                 @unique
  phoneVerifiedAt                DateTime?
  name                           String?
  wechatNickname                 String?
  profileCompletedAt             DateTime?
  // [新增] 用户姓名 (New: User's name)
  avatarUrl                      String?
  // [核心新增] 用户头像URL
  password                       String?
  wechatOpenId                   String?                 @unique
  wechatUnionId                  String?                 @unique
  globalRole                     GlobalRole              @default(USER)
  status                         UserStatus              @default(ACTIVE)
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt
  tenants                        TenantUser[] // User can belong to multiple tenants
  priceRecords                   PriceRecord[]
  createdTasks                   ProductionTask[]        @relation("TaskCreator")
  startedTasks                   ProductionTask[]        @relation("TaskStarter")
  paymentOrders                  PaymentOrder[]
  createdRecipeVersions          RecipeVersion[]         @relation("RecipeVersionCreator")
  recipeOperationLogs            RecipeOperationLog[]    @relation("RecipeOperationActor")
  recipeEditorSessions           RecipeEditorSession[]
  recipeDrafts                   RecipeDraft[]
  storeApplications              StoreApplication[]      @relation("StoreApplicationApplicant")
  reviewedStoreApplications      StoreApplication[]      @relation("StoreApplicationReviewer")
  createdJoinLinks               TenantJoinLink[]        @relation("JoinLinkCreator")
  membershipApplications         MembershipApplication[] @relation("MembershipApplicant")
  reviewedMembershipApplications MembershipApplication[] @relation("MembershipReviewer")

  @@index([profileCompletedAt, createdAt])
}

model SmsVerificationCode {
  id           String     @id @default(uuid())
  phone        String
  purpose      SmsPurpose
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int        @default(0)
  requestIp    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([phone, purpose, createdAt(sort: Desc)])
  @@index([requestIp, createdAt(sort: Desc)])
  @@index([expiresAt])
}

// 租户/店铺模型
model Tenant {
  id                       String                  @id @default(uuid())
  name                     String
  address                  String
  // status 字段来管理店铺状态
  status                   TenantStatus            @default(ACTIVE)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  trialStartedAt           DateTime?
  trialEndsAt              DateTime?
  freeTierResetAt          DateTime?
  trialEntitlementPolicyId String?
  members                  TenantUser[]
  invitations              Invitation[]
  ingredients              Ingredient[]
  recipeFamilies           RecipeFamily[] // 一个店铺可以有多个配方族
  recipeOperationLogs      RecipeOperationLog[]
  productionTasks          ProductionTask[] // 一个店铺可以有多个生产任务
  subscriptions            TenantSubscription[]
  paymentOrders            PaymentOrder[]
  recipeEditorSessions     RecipeEditorSession[]
  recipeDrafts             RecipeDraft[]
  recipeImportJobs         RecipeImportJob[]
  storeApplication         StoreApplication?
  joinLinks                TenantJoinLink[]
  membershipApplications   MembershipApplication[]
  trialEntitlementPolicy   EntitlementPolicy?      @relation("TenantTrialPolicy", fields: [trialEntitlementPolicyId], references: [id])
}

model StoreApplication {
  id              String            @id @default(uuid())
  applicantId     String
  storeName       String
  address         String
  description     String?
  contactName     String
  contactPhone    String
  wechatNickname  String?
  status          ApplicationStatus @default(PENDING)
  reviewedById    String?
  reviewNote      String?
  reviewedAt      DateTime?
  createdTenantId String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  applicant       User              @relation("StoreApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  reviewer        User?             @relation("StoreApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdTenant   Tenant?           @relation(fields: [createdTenantId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([applicantId, status])
}

model TenantJoinLink {
  id           String                  @id @default(uuid())
  tenantId     String
  createdById  String
  tokenHash    String                  @unique
  role         TenantRole              @default(MEMBER)
  status       JoinLinkStatus          @default(ACTIVE)
  expiresAt    DateTime
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User                    @relation("JoinLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)
  applications MembershipApplication[]

  @@index([tenantId, status, expiresAt])
}

model MembershipApplication {
  id             String            @id @default(uuid())
  joinLinkId     String
  tenantId       String
  applicantId    String
  displayName    String
  wechatNickname String?
  message        String?
  status         ApplicationStatus @default(PENDING)
  reviewedById   String?
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  joinLink       TenantJoinLink    @relation(fields: [joinLinkId], references: [id], onDelete: Cascade)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicant      User              @relation("MembershipApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  reviewer       User?             @relation("MembershipReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([joinLinkId, applicantId])
  @@unique([tenantId, applicantId])
  @@index([tenantId, status, createdAt])
  @@index([applicantId, status])
}

model RecipeEditorSession {
  id         String                    @id @default(uuid())
  token      String                    @unique
  status     RecipeEditorSessionStatus @default(PENDING)
  tenantId   String?
  userId     String?
  actorRole  String                    @default("USER")
  tenantRole String?
  expiresAt  DateTime
  approvedAt DateTime?
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  tenant     Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([tenantId, createdAt])
}

model RecipeDraft {
  id          String            @id @default(uuid())
  tenantId    String
  createdById String?
  actorRole   String            @default("USER")
  title       String
  status      RecipeDraftStatus @default(DRAFT)
  payload     Json
  syncedAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, status, updatedAt])
  @@index([createdById, createdAt])
}

model RecipeImportJob {
  id                  String                @id @default(uuid())
  tenantId            String
  status              RecipeImportJobStatus @default(PENDING)
  fileName            String?
  mimeType            String?
  sourceData          Bytes?
  sourceText          String?
  catalogContext      String
  result              Json?
  diagnosticData      Json?
  diagnosticExpiresAt DateTime?
  errorMessage        String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([diagnosticExpiresAt])
}

// 用户与租户的多对多关系表
model TenantUser {
  userId   String
  tenantId String
  role     TenantRole @default(MEMBER)
  status   UserStatus @default(PENDING) // Status within the tenant
  user     User       @relation(fields: [userId], references: [id])
  tenant   Tenant     @relation(fields: [tenantId], references: [id])

  @@id([userId, tenantId])
}

// 邀请模型
model Invitation {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  phone     String
  role      TenantRole
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, phone])
}

// ================================================================= //
//                         SUBSCRIPTION BILLING                      //
// ================================================================= //

model SubscriptionPlan {
  id                   String               @id @default(uuid())
  code                 String               @unique
  name                 String
  durationDays         Int
  priceInCents         Int
  originalPriceInCents Int?
  isActive             Boolean              @default(true)
  sortOrder            Int                  @default(0)
  tier                 EntitlementTier      @default(PRO)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  subscriptions        TenantSubscription[]
  paymentOrders        PaymentOrder[]

  @@index([isActive, sortOrder])
}

model EntitlementPolicy {
  id            String                  @id @default(uuid())
  tier          EntitlementTier
  version       Int
  name          String
  status        EntitlementPolicyStatus @default(DRAFT)
  isDefault     Boolean                 @default(false)
  config        Json
  publishedAt   DateTime?
  retiredAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  subscriptions TenantSubscription[]
  paymentOrders PaymentOrder[]
  trialTenants  Tenant[]                @relation("TenantTrialPolicy")

  @@unique([tier, version])
  @@index([tier, status, isDefault])
}

model BillingSettings {
  id        String   @id @default("default")
  trialDays Int      @default(14)
  graceDays Int      @default(7)
  updatedAt DateTime @updatedAt
}

model TenantSubscription {
  id                  String             @id @default(uuid())
  tenantId            String
  planId              String
  entitlementPolicyId String
  status              SubscriptionStatus @default(ACTIVE)
  startsAt            DateTime
  expiresAt           DateTime
  source              String             @default("manual")
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  plan                SubscriptionPlan   @relation(fields: [planId], references: [id])
  entitlementPolicy   EntitlementPolicy  @relation(fields: [entitlementPolicyId], references: [id])
  orders              PaymentOrder[]

  @@index([tenantId, status])
  @@index([expiresAt])
}

model PaymentOrder {
  id                  String              @id @default(uuid())
  orderNo             String              @unique
  tenantId            String
  userId              String?
  planId              String
  entitlementPolicyId String
  subscriptionId      String?
  amountInCents       Int
  status              PaymentOrderStatus  @default(PENDING)
  channel             String              @default("wechat")
  prepayId            String?
  transactionId       String?
  refundAmountInCents Int                 @default(0)
  lastSyncedAt        DateTime?
  failureReason       String?
  paidAt              DateTime?
  closedAt            DateTime?
  refundedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  user                User?               @relation(fields: [userId], references: [id])
  plan                SubscriptionPlan    @relation(fields: [planId], references: [id])
  entitlementPolicy   EntitlementPolicy   @relation(fields: [entitlementPolicyId], references: [id])
  subscription        TenantSubscription? @relation(fields: [subscriptionId], references: [id])
  refunds             PaymentRefund[]

  @@index([tenantId, status])
  @@index([userId])
  @@index([createdAt])
}

model PaymentRefund {
  id             String              @id @default(uuid())
  refundNo       String              @unique
  orderId        String
  amountInCents  Int
  reason         String?
  status         PaymentRefundStatus @default(PENDING)
  wechatRefundId String?
  successAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  order          PaymentOrder        @relation(fields: [orderId], references: [id])

  @@index([orderId, status])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorRole   String?
  action      String
  method      String
  path        String
  targetType  String?
  targetId    String?
  statusCode  Int
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

// ================================================================= //
//                           RECIPE MODELS                       //
// ================================================================= //

// 配方族：用于管理一个配方的所有版本
// 例如，“甜面团”是一个Family，它可能有V1, V2等多个Version
model RecipeFamily {
  id                         String                @id @default(uuid())
  name                       String // 配方名称，如“甜面团”、“烫种”
  tenantId                   String
  type                       RecipeType // 配方类型 (主配方, 预制面团, 或附加项)
  category                   RecipeCategory        @default(BREAD) // [核心新增] 配方品类
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  deletedAt                  DateTime?
  freeTierUnlocked           Boolean               @default(true)
  tenant                     Tenant                @relation(fields: [tenantId], references: [id])
  versions                   RecipeVersion[] // 一个配方族包含多个版本
  operationLogs              RecipeOperationLog[]
  // [核心修改] 当此配方作为预制面团在其他配方中使用时
  usedInComponentsAsPreDough ComponentIngredient[] @relation("PreDoughLink")
  // [核心修改] 当此配方作为附加项(馅料/装饰)在其他配方中使用时
  usedInComponentsAsExtra    ComponentIngredient[] @relation("ExtraLink_Component") // [G-Code-Note] 新增的 relation name

  // [G-Code-Note] 这个关系是用于 ProductIngredient 的，保持不变
  usedInProducts ProductIngredient[] @relation("ExtraLink")

  // [新增] 关联：该配方产出的自制原料 (仅针对 PRE_DOUGH 和 EXTRA)
  outputIngredient Ingredient? @relation("RecipeOutput")

  @@unique([tenantId, name, deletedAt])
  @@index([tenantId])
  @@index([tenantId, type, freeTierUnlocked])
}

// 配方版本：记录配方的具体版本信息
model RecipeVersion {
  id                   String                @id @default(uuid())
  familyId             String // 所属配方族ID
  version              Int // 版本号
  notes                String?
  // 版本备注，如“夏季版，减少水量”
  changeSummary        Json?
  // 相对上一版本自动生成的修改摘要
  createdById          String?
  isActive             Boolean               @default(true) // 是否为当前激活版本
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  family               RecipeFamily          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy            User?                 @relation("RecipeVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  operationLogs        RecipeOperationLog[]
  components           RecipeComponent[] // [核心重命名] doughs -> components
  products             Product[] // 该版本包含的最终产品 (仅MAIN类型的配方有)
  usedAsPreDough       ComponentIngredient[] @relation("PreDoughVersionLink")
  usedAsComponentExtra ComponentIngredient[] @relation("ComponentExtraVersionLink")
  usedAsProductExtra   ProductIngredient[]   @relation("ProductExtraVersionLink")

  @@unique([familyId, version])
  @@index([familyId])
  @@index([createdById])
}

model RecipeOperationLog {
  id          String         @id @default(uuid())
  tenantId    String
  familyId    String
  versionId   String?
  actorUserId String?
  action      String
  description String
  metadata    Json?
  createdAt   DateTime       @default(now())
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  family      RecipeFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  version     RecipeVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  actor       User?          @relation("RecipeOperationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([familyId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

// [核心重命名] Dough -> RecipeComponent，使其成为一个更通用的配方组件模型
model RecipeComponent {
  id                 String                @id @default(uuid())
  recipeVersionId    String // 所属配方版本ID
  name               String // 组件名称，如“主面团”、“烫种”、“卡仕达酱”
  targetTemp         Decimal?
  // [核心修改] 出缸温度
  lossRatio          Decimal               @default(0) // [核心修改] 损耗率
  divisionLoss       Decimal               @default(0) // [核心新增] 分割定额损耗(克)
  customWaterContent Decimal?
  // [核心新增] 自定义含水量(0-100)，如果设置则覆盖计算值
  procedure          String[] // 制作流程要点
  recipeVersion      RecipeVersion         @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  ingredients        ComponentIngredient[] // 组件包含的原料

  @@index([recipeVersionId])
}

// [核心重命名] DoughIngredient -> ComponentIngredient
model ComponentIngredient {
  id          String   @id @default(uuid())
  componentId String // [核心重命名] doughId -> componentId
  ratio       Decimal?
  flourRatio  Decimal?

  // G-Code-Note: 这是一个原料（如“面粉”）
  ingredientId String?
  // [核心修改] 用于关联Ingredient模型
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onUpdate: Cascade, onDelete: SetNull)

  // [G-Code-Note] [核心修改] 字段重命名并拆分

  // G-Code-Note: 这是一个面种配方 (如 "烫种")
  preDoughId            String?
  linkedPreDough        RecipeFamily?  @relation("PreDoughLink", fields: [preDoughId], references: [id])
  preDoughVersionId     String?
  linkedPreDoughVersion RecipeVersion? @relation("PreDoughVersionLink", fields: [preDoughVersionId], references: [id], onDelete: Restrict)

  // G-Code-Note: 这是一个馅料配方 (如 "卡仕达酱")
  extraId            String?
  linkedExtra        RecipeFamily?  @relation("ExtraLink_Component", fields: [extraId], references: [id])
  extraVersionId     String?
  linkedExtraVersion RecipeVersion? @relation("ComponentExtraVersionLink", fields: [extraVersionId], references: [id], onDelete: Restrict)

  component RecipeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade) // [核心重命名] dough -> component

  @@index([componentId]) // [核心重命名] doughId -> componentId
  @@index([preDoughId]) // [G-Code-Note] 原来的 linkedPreDoughId
  @@index([preDoughVersionId])
  @@index([extraId]) // [G-Code-Note] 新增
  @@index([extraVersionId])
  @@index([ingredientId])
}

// 最终产品：由配方制作出的具体面包或产品
model Product {
  id                 String                            @id @default(uuid())
  recipeVersionId    String // 所属配方版本ID
  name               String // 产品名称，如“熊掌卡仕达”
  baseDoughWeight    Decimal // [核心修改] 基础面团克重
  procedure          String[] // 制作流程要点 (如烘烤参数)
  deletedAt          DateTime?
  // [核心新增] 用于支持软删除
  recipeVersion      RecipeVersion                     @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  ingredients        ProductIngredient[] // 产品的附加原料 (搅拌、馅料、装饰)
  productionTasks    ProductionTaskItem[]
  spoilageLogs       ProductionTaskSpoilageLog[]
  overproductionLogs ProductionTaskOverproductionLog[]

  @@index([recipeVersionId])
  @@index([deletedAt]) // [核心新增] 为软删除增加索引
}

// 产品的附加原料：搅拌、馅料、装饰
model ProductIngredient {
  id                   String                @id @default(uuid())
  productId            String // 所属产品ID
  type                 ProductIngredientType // 原料类型 (搅拌/馅料/装饰)
  ingredientId         String?
  // [核心修改] 用于关联Ingredient模型
  ingredient           Ingredient?           @relation(fields: [ingredientId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  ratio                Decimal?
  weightInGrams        Decimal? // [核心修改] 馅料/装饰类原料，单位克
  linkedExtraId        String?
  linkedExtraVersionId String?
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  linkedExtra          RecipeFamily?         @relation("ExtraLink", fields: [linkedExtraId], references: [id])
  linkedExtraVersion   RecipeVersion?        @relation("ProductExtraVersionLink", fields: [linkedExtraVersionId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([linkedExtraId])
  @@index([linkedExtraVersionId])
  @@index([ingredientId])
}

// ================================================================= //
//                  INGREDIENTS & PRICING                    //
// ================================================================= //

model IngredientPreset {
  id           String   @id @default(uuid())
  name         String   @unique
  isFlour      Boolean  @default(false)
  waterContent Decimal  @default(0)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// 原料品类模型
model Ingredient {
  id           String         @id @default(uuid())
  tenantId     String
  name         String // e.g., "High-gluten flour"
  type         IngredientType @default(STANDARD)
  isFlour      Boolean        @default(false)
  waterContent Decimal        @default(0) // [核心修改] 含水量
  activeSkuId  String?

  // [新增] 保质期 (小时)，默认为 0 表示不管理或长期有效
  shelfLife Int @default(0)

  // [新增] 关联：该原料是由哪个配方生产的 (仅针对 SELF_MADE)
  recipeFamilyId String?       @unique
  recipeFamily   RecipeFamily? @relation("RecipeOutput", fields: [recipeFamilyId], references: [id])

  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  deletedAt            DateTime?
  tenant               Tenant                     @relation(fields: [tenantId], references: [id])
  skus                 IngredientSKU[]
  consumptionLogs      IngredientConsumptionLog[]
  activeSku            IngredientSKU?             @relation("ActiveSKU", fields: [activeSkuId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  componentIngredients ComponentIngredient[] // [核心重命名] doughIngredients -> componentIngredients
  productIngredients   ProductIngredient[]

  @@unique([tenantId, name, deletedAt])
}

// 原料SKU模型
model IngredientSKU {
  id                   String                     @id @default(uuid())
  brand                String?
  specName             String // e.g., "1kg bag"
  specWeightInGrams    Decimal // [核心修改] 规格克重
  ingredientId         String
  status               SkuStatus                  @default(INACTIVE)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  ingredient           Ingredient                 @relation(fields: [ingredientId], references: [id])
  priceRecords         PriceRecord[]
  consumptionLogs      IngredientConsumptionLog[]
  activeForIngredients Ingredient[]               @relation("ActiveSKU")
}

// 价格记录模型：用于记录规格价格并计算配方成本
model PriceRecord {
  id              String        @id @default(uuid())
  skuId           String
  packageCount    Int           @map("packagesPurchased")
  pricePerPackage Decimal
  recordedAt      DateTime      @default(now()) @map("purchaseDate")
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  sku             IngredientSKU @relation(fields: [skuId], references: [id])

  @@index([userId])
  @@index([skuId, recordedAt(sort: Desc)])
  @@map("ProcurementRecord")
}

// ================================================================= //
//                  PRODUCTION & TASKS                 //
// ================================================================= //

// 生产任务模型
model ProductionTask {
  id                   String               @id @default(uuid())
  tenantId             String
  status               ProductionTaskStatus @default(PENDING)
  startDate            DateTime
  endDate              DateTime?
  notes                String?
  recipeSnapshot       Json?
  // 最终配方快照，仅在任务完成时创建
  executionStartedAt   DateTime?
  executionStartedById String?
  executionBaseline    Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  createdById          String // [核心新增] 创建任务的用户ID
  createdBy            User                 @relation("TaskCreator", fields: [createdById], references: [id])
  executionStartedBy   User?                @relation("TaskStarter", fields: [executionStartedById], references: [id], onDelete: Restrict)
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  log                  ProductionLog?
  items                ProductionTaskItem[]

  @@index([tenantId])
  @@index([createdById]) // [核心新增] 为创建者ID添加索引
  @@index([executionStartedById])
}

// 生产任务清单项 (中间表)
model ProductionTaskItem {
  id        String         @id @default(uuid())
  taskId    String
  productId String
  quantity  Decimal // [核心修改] 从 Int 改为 Decimal，支持自制原料等带小数的产出/投入量
  role      TaskItemRole   @default(FINAL_PRODUCT) // 新增字段：表示在任务中的角色
  task      ProductionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict) // [核心修改] Cascade -> Restrict

  @@index([taskId])
  @@index([productId])
}

// ================================================================= //
//                  PRODUCTION LOGS & CONSUMPTION                //
// ================================================================= //

// 生产日志模型
model ProductionLog {
  id                 String                            @id @default(uuid())
  taskId             String                            @unique
  completedAt        DateTime                          @default(now())
  notes              String?
  // [核心修改] recipeSnapshot 字段已移动到 ProductionTask
  task               ProductionTask                    @relation(fields: [taskId], references: [id])
  consumptionLogs    IngredientConsumptionLog[]
  spoilageLogs       ProductionTaskSpoilageLog[]
  overproductionLogs ProductionTaskOverproductionLog[]

  @@index([taskId])
}

// 生产任务损耗日志模型
model ProductionTaskSpoilageLog {
  id              String        @id @default(uuid())
  productionLogId String
  productId       String? // [核心修改] 改为可选
  productName     String // [核心新增] 冗余存储产品名称
  stage           String // e.g., 'kneading', 'fermentation', 'baking'
  quantity        Decimal // [核心修改] 从 Int 改为 Decimal，支持自制原料的精确报损
  notes           String?
  createdAt       DateTime      @default(now())
  productionLog   ProductionLog @relation(fields: [productionLogId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull) // [核心修改] 改为可选，onDelete: SetNull

  @@index([productionLogId])
  @@index([productId])
}

// 新增超量生产日志模型
model ProductionTaskOverproductionLog {
  id              String        @id @default(uuid())
  productionLogId String
  productId       String?
  // [核心修改] 改为可选
  productName     String // [核心新增] 冗余存储产品名称
  quantity        Decimal // [核心修改] 从 Int 改为 Decimal，支持自制原料的精确超产
  createdAt       DateTime      @default(now())
  productionLog   ProductionLog @relation(fields: [productionLogId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull) // [核心修改] 改为可选，onDelete: SetNull

  @@index([productionLogId])
  @@index([productId])
}

// 原料消耗日志模型
model IngredientConsumptionLog {
  id              String         @id @default(uuid())
  productionLogId String
  ingredientId    String
  skuId           String?
  quantityInGrams Decimal // [核心修改] 消耗克重
  unitPrice       Decimal? // [核心新增] 消耗时该原料的每克单价
  productionLog   ProductionLog  @relation(fields: [productionLogId], references: [id])
  ingredient      Ingredient     @relation(fields: [ingredientId], references: [id])
  sku             IngredientSKU? @relation(fields: [skuId], references: [id])

  @@index([productionLogId])
  @@index([ingredientId])
  @@index([skuId])
}
