# ==============================
# 基础运行
# ==============================

# Node 运行环境；本地开发使用 development。
NODE_ENV=development

# 支付提供方；本地默认 mock，不调用真实微信支付。
PAYMENT_PROVIDER=mock

# 慢请求日志阈值，单位毫秒。
SLOW_REQUEST_THRESHOLD_MS=1000


# ==============================
# 数据库
# ==============================

# 本地开发数据库连接地址。
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/baking-saas


# ==============================
# 安全与访问控制
# ==============================

# 本地开发 JWT 签名密钥。
JWT_SECRET=replace-with-a-long-random-development-secret

# 开发环境 CORS 来源；留空时后端开发模式允许便利跨域。
CORS_ORIGINS=

# 开发环境默认启用 Swagger 接口文档。
SWAGGER_ENABLED=true


# ==============================
# 微信登录
# ==============================

# 微信认证提供方；本地开发使用 mock，可绕过真实微信登录。
WECHAT_AUTH_PROVIDER=mock


# ==============================
# 短信验证
# ==============================

# 短信服务提供方；本地开发使用 mock，不发送真实短信。
SMS_PROVIDER=mock

# mock 短信固定验证码。
SMS_TEST_CODE=123456

# 短信验证码有效期，单位秒。
SMS_CODE_EXPIRES_SECONDS=300

# 同一手机号发送验证码冷却时间，单位秒。
SMS_CODE_COOLDOWN_SECONDS=60


# ==============================
# 智能导入
# ==============================

# 智能导入模型提供方。
RECIPE_IMPORT_PROVIDER=openai-compatible

# 智能导入 API base URL。
RECIPE_IMPORT_BASE_URL=https://api.openai.com/v1

# 智能导入使用的模型名称。
RECIPE_IMPORT_MODEL=gpt-5.4-mini

# 智能导入 API Key；留空时可用标准 JSON 粘贴做 UI 测试。
RECIPE_IMPORT_API_KEY=

# 是否记录模型原始输出；开发一般也保持 false。
RECIPE_IMPORT_LOG_MODEL_OUTPUT=false

# 智能导入单次请求最大 token 数。
RECIPE_IMPORT_MAX_TOKENS=32768

# 智能导入请求超时时间，单位毫秒。
RECIPE_IMPORT_TIMEOUT_MS=240000
