NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/baking-saas
JWT_SECRET=replace-with-a-long-random-development-secret

# Local SMS testing: no real message is sent and the API returns debugCode.
SMS_PROVIDER=mock
WECHAT_AUTH_PROVIDER=mock
SMS_TEST_CODE=123456
SMS_CODE_EXPIRES_SECONDS=300
SMS_CODE_COOLDOWN_SECONDS=60

# mock: complete payment and subscription immediately without contacting WeChat Pay.
# wechat: use the real WeChat Pay API even during local development.
PAYMENT_PROVIDER=mock

# Optional. Without a key, development accepts standard JSON paste for UI testing.
RECIPE_IMPORT_PROVIDER=openai-compatible
RECIPE_IMPORT_BASE_URL=https://api.openai.com/v1
RECIPE_IMPORT_MODEL=gpt-5.4-mini
RECIPE_IMPORT_API_KEY=
RECIPE_IMPORT_LOG_MODEL_OUTPUT=false
RECIPE_IMPORT_MAX_TOKENS=32768
RECIPE_IMPORT_TIMEOUT_MS=240000
