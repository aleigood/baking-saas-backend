NODE_ENV=production
PAYMENT_PROVIDER=wechat
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/baking-saas
JWT_SECRET=replace-with-a-long-random-secret

# Production must use a real provider implementation. "mock" is rejected in production.
SMS_PROVIDER=replace-with-real-provider
SMS_CODE_EXPIRES_SECONDS=300
SMS_CODE_COOLDOWN_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5
SMS_PHONE_HOURLY_LIMIT=5
SMS_PHONE_DAILY_LIMIT=10
SMS_IP_HOURLY_LIMIT=20
SMS_IP_DAILY_LIMIT=100

SUPER_ADMIN_PHONE=replace-me
SUPER_ADMIN_PASSWORD=replace-me

WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=replace-me
WECHAT_PAY_MCH_ID=replace-me
WECHAT_PAY_SERIAL_NO=replace-me
WECHAT_PAY_API_V3_KEY=32-character-api-v3-key
WECHAT_PAY_PRIVATE_KEY_BASE64=base64-of-apiclient-key-pem
WECHAT_PAY_PLATFORM_PUBLIC_KEY_BASE64=base64-of-wechatpay-platform-public-key-pem
WECHAT_PAY_NOTIFY_URL=https://api.example.com/billing/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/billing/wechat/refund-notify

# Enable only after existing tenants have valid subscriptions.
