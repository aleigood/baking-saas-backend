# ==============================
# 基础运行
# ==============================

# Node 运行环境；生产部署必须为 production。
NODE_ENV=production

# 支付提供方；生产使用 wechat，开发/测试可使用 mock。
PAYMENT_PROVIDER=wechat

# 慢请求日志阈值，单位毫秒；超过后会记录方法、路径、状态码、耗时。
SLOW_REQUEST_THRESHOLD_MS=1000


# ==============================
# 数据库
# ==============================

# PostgreSQL 容器初始化用户名；需与 DATABASE_URL 保持一致。
POSTGRES_USER=baking_saas

# PostgreSQL 容器初始化密码；生产应替换为高强度随机密码。
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# PostgreSQL 容器初始化数据库名。
POSTGRES_DB=baking-saas

# 后端连接数据库的地址；Docker compose 内部访问数据库服务名使用 db。
DATABASE_URL=postgresql://baking_saas:replace-with-a-long-random-database-password@db:5432/baking-saas


# ==============================
# 安全与访问控制
# ==============================

# JWT 签名密钥；必须替换为足够长、不可猜测的随机字符串。
JWT_SECRET=replace-with-a-long-random-secret

# 允许跨域访问后端的正式前端域名，多个域名用英文逗号分隔。
CORS_ORIGINS=https://admin.example.com,https://app.example.com

# 是否启用 Swagger 接口文档；生产默认 false。
SWAGGER_ENABLED=false

# 生产环境临时启用 Swagger 时使用的 Basic Auth 用户名。
SWAGGER_USER=

# 生产环境临时启用 Swagger 时使用的 Basic Auth 密码。
SWAGGER_PASSWORD=


# ==============================
# 超级管理员初始化
# ==============================

# 生产 seed 自动创建/确认的超级管理员手机号。
SUPER_ADMIN_PHONE=replace-me

# 生产 seed 自动创建超级管理员时使用的初始密码。
SUPER_ADMIN_PASSWORD=replace-me


# ==============================
# 短信验证
# ==============================

# 短信服务提供方；接入腾讯云后使用 tencent。未接入时可用 disabled。
SMS_PROVIDER=tencent

# 当前未接腾讯短信时可设为 true，并配合 SMS_PROVIDER=disabled 走人工验证。
MANUAL_SMS_VERIFICATION_ENABLED=false

# 腾讯云 API SecretId。
TENCENT_CLOUD_SECRET_ID=replace-me

# 腾讯云 API SecretKey。
TENCENT_CLOUD_SECRET_KEY=replace-me

# 腾讯云短信服务地域。
TENCENT_SMS_REGION=ap-guangzhou

# 腾讯云短信应用 SDK AppID。
TENCENT_SMS_SDK_APP_ID=1400000000

# 腾讯云短信签名名称。
TENCENT_SMS_SIGN_NAME=replace-with-approved-sign-name

# 腾讯云短信模板 ID。
TENCENT_SMS_TEMPLATE_ID=replace-with-approved-template-id

# 腾讯短信模板参数顺序；可用 code、minutes、seconds，需匹配模板变量顺序。
TENCENT_SMS_TEMPLATE_PARAMS=code,minutes

# 腾讯云短信 API endpoint，通常无需修改。
TENCENT_SMS_ENDPOINT=sms.tencentcloudapi.com

# 短信验证码有效期，单位秒。
SMS_CODE_EXPIRES_SECONDS=300

# 同一手机号发送验证码冷却时间，单位秒。
SMS_CODE_COOLDOWN_SECONDS=60

# 单个验证码最大尝试次数。
SMS_CODE_MAX_ATTEMPTS=5

# 单手机号每小时发送上限。
SMS_PHONE_HOURLY_LIMIT=5

# 单手机号每日发送上限。
SMS_PHONE_DAILY_LIMIT=10

# 单 IP 每小时发送上限。
SMS_IP_HOURLY_LIMIT=20

# 单 IP 每日发送上限。
SMS_IP_DAILY_LIMIT=100


# ==============================
# 微信登录
# ==============================

# 微信小程序 AppID，用于微信登录。
WECHAT_APP_ID=wx0000000000000000

# 微信小程序 AppSecret，用于服务端换取微信登录信息。
WECHAT_APP_SECRET=replace-me

# 微信认证提供方；生产为 wechat。
WECHAT_AUTH_PROVIDER=wechat


# ==============================
# 微信支付
# ==============================

# 微信支付商户号。
WECHAT_PAY_MCH_ID=replace-me

# 微信支付 API 证书序列号。
WECHAT_PAY_SERIAL_NO=replace-me

# 微信支付 API v3 密钥，必须为 32 字符。
WECHAT_PAY_API_V3_KEY=32-character-api-v3-key

# 微信支付商户私钥 PEM 的 base64 内容。
WECHAT_PAY_PRIVATE_KEY_BASE64=base64-of-apiclient-key-pem

# 微信支付平台公钥 PEM 的 base64 内容。
WECHAT_PAY_PLATFORM_PUBLIC_KEY_BASE64=base64-of-wechatpay-platform-public-key-pem

# 微信支付结果通知地址，需为公网 HTTPS 回调。
WECHAT_PAY_NOTIFY_URL=https://api.example.com/billing/wechat/notify

# 微信退款结果通知地址，需为公网 HTTPS 回调。
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/billing/wechat/refund-notify


# ==============================
# 智能导入
# ==============================

# 智能导入模型提供方。
RECIPE_IMPORT_PROVIDER=openai-compatible

# 智能导入 API base URL。
RECIPE_IMPORT_BASE_URL=https://api.openai.com/v1

# 智能导入使用的模型名称。
RECIPE_IMPORT_MODEL=gpt-5.4-mini

# 智能导入 API Key。
RECIPE_IMPORT_API_KEY=replace-me

# DeepSeek 备选配置：需要时取消注释并替换上面的导入配置。
# RECIPE_IMPORT_PROVIDER=deepseek
# RECIPE_IMPORT_BASE_URL=https://api.deepseek.com
# RECIPE_IMPORT_MODEL=deepseek-v4-flash

# 是否记录模型原始输出；生产建议 false。
RECIPE_IMPORT_LOG_MODEL_OUTPUT=false

# 智能导入单次请求最大 token 数。
RECIPE_IMPORT_MAX_TOKENS=32768

# 智能导入请求超时时间，单位毫秒。
RECIPE_IMPORT_TIMEOUT_MS=240000

# 是否复用最近一次相同来源的成功导入结果，降低重复调用成本。
RECIPE_IMPORT_REUSE_LAST_SUCCESS=true

# 复用成功导入结果的有效期，单位毫秒。
RECIPE_IMPORT_REUSE_LAST_SUCCESS_TTL_MS=86400000
