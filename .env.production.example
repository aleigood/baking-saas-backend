NODE_ENV=production
PAYMENT_PROVIDER=wechat
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/baking-saas
JWT_SECRET=replace-with-a-long-random-secret

# Production uses Tencent Cloud SMS. "mock" is available only in development.
SMS_PROVIDER=tencent
TENCENT_CLOUD_SECRET_ID=replace-me
TENCENT_CLOUD_SECRET_KEY=replace-me
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=1400000000
TENCENT_SMS_SIGN_NAME=replace-with-approved-sign-name
TENCENT_SMS_TEMPLATE_ID=replace-with-approved-template-id
# Supported values: code, minutes, seconds. Their order must match the approved template variables.
TENCENT_SMS_TEMPLATE_PARAMS=code,minutes
TENCENT_SMS_ENDPOINT=sms.tencentcloudapi.com
SMS_CODE_EXPIRES_SECONDS=300
SMS_CODE_COOLDOWN_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5
SMS_PHONE_HOURLY_LIMIT=5
SMS_PHONE_DAILY_LIMIT=10
SMS_IP_HOURLY_LIMIT=20
SMS_IP_DAILY_LIMIT=100

SUPER_ADMIN_PHONE=replace-me
SUPER_ADMIN_PASSWORD=replace-me

WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=replace-me
WECHAT_AUTH_PROVIDER=wechat
WECHAT_PAY_MCH_ID=replace-me
WECHAT_PAY_SERIAL_NO=replace-me
WECHAT_PAY_API_V3_KEY=32-character-api-v3-key
WECHAT_PAY_PRIVATE_KEY_BASE64=base64-of-apiclient-key-pem
WECHAT_PAY_PLATFORM_PUBLIC_KEY_BASE64=base64-of-wechatpay-platform-public-key-pem
WECHAT_PAY_NOTIFY_URL=https://api.example.com/billing/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/billing/wechat/refund-notify

# Intelligent recipe import (Responses API compatible provider)
RECIPE_IMPORT_PROVIDER=openai-compatible
RECIPE_IMPORT_BASE_URL=https://api.openai.com/v1
RECIPE_IMPORT_MODEL=gpt-5.4-mini
RECIPE_IMPORT_API_KEY=replace-me

# DeepSeek alternative:
# RECIPE_IMPORT_PROVIDER=deepseek
# RECIPE_IMPORT_BASE_URL=https://api.deepseek.com
# RECIPE_IMPORT_MODEL=deepseek-v4-flash
RECIPE_IMPORT_LOG_MODEL_OUTPUT=false
RECIPE_IMPORT_MAX_TOKENS=32768
RECIPE_IMPORT_TIMEOUT_MS=240000

# Enable only after existing tenants have valid subscriptions.
